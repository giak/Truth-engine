grep -n "non seulement.*mais" /home/giak/projects/truth-engine/articles/AUDIT_ARTICLE_POUVOIR_V4_4_FULL_FORENSIC/01_TARGET/ARTICLE_MASTERWORK_SOUVERAINETE_2026.md
```

